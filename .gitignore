# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# var files
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ansible execution retry files
*.retry

# Ansible Lint and Molecule caches
.cache/
.molecule/

# Local development and VSCode extension artifacts
.ansible/
.ansible-lint

# Local connection/configuration overrides
local-configure.yml
vbox_host.cfg

# Python compilation files (Ansible modules run on Python)
*.py[co]
__pycache__/

# Downloaded galaxy roles and collections
# (Only commit your requirements.yml, not the downloaded code)
roles/
collections/
!roles/requirements.yml
!collections/requirements.yml

# Sensitive files containing unencrypted vault passwords
.ansible_vault_password
